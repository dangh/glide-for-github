{
  "name": "pierre-for-github",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension that adds a Pierre tab to GitHub PR pages",
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "zip": "npm run build && rm -f pierre-for-github.zip && cd dist && zip -qr ../pierre-for-github.zip ."
  },
  "dependencies": {
    "@pierre/diffs": "^1.5.2",
    "@pierre/trees": "^1.0.0-beta.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
